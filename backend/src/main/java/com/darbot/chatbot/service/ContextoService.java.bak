package com.darbot.chatbot.service;

import com.darbot.chatbot.entity.Conversacion;
import com.darbot.chatbot.entity.ContextoConversacion;
import com.darbot.chatbot.entity.Mensaje;
import com.darbot.chatbot.repository.ContextoConversacionRepository;
import com.darbot.chatbot.repository.MensajeRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.time.LocalDateTime;
import java.util.List;
import java.util.Optional;

@Service
@RequiredArgsConstructor
@Slf4j
public class ContextoService {

    private final ContextoConversacionRepository contextoRepository;
    private final MensajeRepository mensajeRepository;

    // Indicadores de contexto (preguntas de seguimiento)
    private static final String[] INDICADORES_CONTEXTO = {
        // Preguntas de seguimiento
        "y eso", "y esa", "y el", "y la", 
        "ese", "esa", "eso", "eso que", 
        "a qué hora", "cuándo", "dónde", 
        "y cómo", "y por qué",
        "y para", "para mañana", "para hoy", "para ayer",
        "y mañana", "y hoy", "y ayer",
        "qué hay", "qué tal", "cómo está",
        "y entonces", "y después", "y luego",
        "qué más", "algo más", "otra cosa",
        "y los", "y las", "y ese", "y esa",
        "y el de", "y la de", "y los de", "y las de",
        // Preguntas cortas
        "mañana", "hoy", "ayer", "ese", "esa",
        "ello", "eso", "aquello", "lo mismo",
        // Preguntas con "y"
        " y ", "y el", "y la", "y los", "y las"
    };

    public Optional<ContextoConversacion> obtenerContexto(Conversacion conversacion) {
        return contextoRepository.findByConversacion(conversacion);
    }

    public ContextoConversacion crearContexto(Conversacion conversacion) {
        ContextoConversacion contexto = new ContextoConversacion();
        contexto.setConversacion(conversacion);
        contexto.setFechaActualizacion(LocalDateTime.now());
        return contextoRepository.save(contexto);
    }

    public ContextoConversacion actualizarContexto(
            Conversacion conversacion,
            String intencion,
            String entidad,
            String pregunta,
            String respuesta) {
        
        ContextoConversacion contexto = obtenerContexto(conversacion)
                .orElseGet(() -> crearContexto(conversacion));

        if (intencion != null && !intencion.startsWith("CONTEXTO_")) {
            contexto.setUltimaIntencion(intencion);
        }
        if (entidad != null) {
            contexto.setUltimaEntidad(entidad);
        }
        if (pregunta != null) {
            contexto.setUltimaPregunta(pregunta);
        }
        if (respuesta != null) {
            contexto.setUltimaRespuesta(respuesta);
        }
        
        contexto.setFechaActualizacion(LocalDateTime.now());
        return contextoRepository.save(contexto);
    }

    public boolean esPreguntaDeContexto(String texto) {
        if (texto == null) return false;
        String textoLower = texto.toLowerCase().trim();
        
        // Si la pregunta es muy corta (1-3 palabras), probablemente es contexto
        String[] palabras = textoLower.split("\\s+");
        if (palabras.length <= 3) {
            String[] contextoPalabras = {"mañana", "hoy", "ayer", "eso", "ese", "esa", "ello", "aquello"};
            for (String palabra : contextoPalabras) {
                if (textoLower.contains(palabra)) {
                    log.info("🔍 Contexto detectado por palabra corta: '{}' (palabra: '{}')", texto, palabra);
                    return true;
                }
            }
        }
        
        // Verificar indicadores
        for (String ind : INDICADORES_CONTEXTO) {
            if (textoLower.contains(ind)) {
                log.info("🔍 Contexto detectado por indicador: '{}' (indicador: '{}')", texto, ind);
                return true;
            }
        }
        
        return false;
    }

    public String obtenerUltimaPregunta(Conversacion conversacion) {
        List<Mensaje> mensajes = mensajeRepository.findByConversacionIdOrderByFechaAsc(conversacion.getId());
        for (int i = mensajes.size() - 1; i >= 0; i--) {
            Mensaje m = mensajes.get(i);
            if ("USER".equals(m.getTipo())) {
                return m.getContenido();
            }
        }
        return null;
    }

    public String obtenerUltimaIntencion(Conversacion conversacion) {
        Optional<ContextoConversacion> contexto = obtenerContexto(conversacion);
        return contexto.map(ContextoConversacion::getUltimaIntencion).orElse(null);
    }

    public String obtenerUltimaEntidad(Conversacion conversacion) {
        Optional<ContextoConversacion> contexto = obtenerContexto(conversacion);
        return contexto.map(ContextoConversacion::getUltimaEntidad).orElse(null);
    }
}